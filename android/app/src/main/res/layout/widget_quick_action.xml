<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#17212b"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_qa_btn_keluar"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="#881337"
        android:gravity="center"
        android:text="- Keluar"
        android:textColor="#ffe4e6"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_qa_btn_masuk"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="#064e3b"
        android:gravity="center"
        android:text="+ Masuk"
        android:textColor="#d1fae5"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_qa_btn_tugas"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="#1e3a8a"
        android:gravity="center"
        android:text="Tugas"
        android:textColor="#dbeafe"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_qa_btn_impian"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="#78350f"
        android:gravity="center"
        android:text="Impian"
        android:textColor="#fef3c7"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
